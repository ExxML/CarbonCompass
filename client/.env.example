# Browser-exposed key, inlined into the bundle at build time.
# Use a development key restricted to localhost referrers; the production key is
# set in the Vercel project settings and stays restricted to the deployed domain.
VITE_GOOGLE_MAPS_API_KEY=

# Base URL of the Carbon Compass server. Defaults to http://localhost:3001.
VITE_API_URL=http://localhost:3001
